def check_phase_diffusion_regime(I_crit, T):
    """
    E_J vs k_B*T check, following Liu et al. 2021 / Ambegaokar-Halperin.
    E_J < kT means expect phase-diffusive (smeared, resistive) behavior.
    """
    E_J = hbar * I_crit / (2 * e)
    ratio = E_J / (kb * T)
    regime = "phase-diffusive (smeared)" if ratio < 1 else "coherent (sharp steps)"
    return E_J, ratio, regime

