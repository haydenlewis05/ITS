def extract_step_widths(df, i_col, v_col, slope_thresh, max_gradient, min_points):
    '''
    extracts the step widths of the different junctions.
    inputs:
    - dataframe
    - i_col = current values in dataframe
    - v_col = voltage values in dataframe
    - slope_thresh = threshhold for the values of the slope
    - max_ gradient = maximum gradient allowed by the model
    - min_points = minimum number of points for flat steps

    '''
    df = df.groupby(i_col, as_index=False)[v_col].mean().sort_values(i_col).reset_index(drop=True)
    I = df[i_col].values
    V = df[v_col].values

    dVdI = np.gradient(V, I)                                        ## smoothed local slope
    point_to_point = np.diff(V) / np.diff(I)                        ## raw slope between neighbours
    point_to_point = np.append(point_to_point, point_to_point[-1])  ## make sure its the same length as I 

    flat = np.abs(dVdI) < slope_thresh        ## detect flat values

    steps = []
    start = None
    for idx in range(len(flat)):
        
        breaks_here = (not flat[idx]) or (np.abs(point_to_point[idx]) > max_gradient) ## break loop if the step isnt flat

        if not breaks_here and start is None:
            start = idx
        if (breaks_here or idx == len(flat) - 1) and start is not None:
            end = idx if breaks_here else idx + 1
            if end - start >= min_points:
                I_seg, V_seg = I[start:end], V[start:end]
                steps.append({
                    "I_min": I_seg.min(),
                    "I_max": I_seg.max(),
                    "width": I_seg.max() - I_seg.min(),
                    "height": V_seg.mean(),
                    "n_points": len(I_seg)
                })
            start = None

    return pd.DataFrame(steps), I, V, dVdI

