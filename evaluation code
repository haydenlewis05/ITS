def josephson_vs_thermal(I_crit, T):
    """
    Ratio of Josephson coupling energy to thermal energy.
    >> 1: deep in the coherent/quantum regime, sharp steps expected
    ~ 1 or < 1: thermal phase diffusion regime, expect smearing
    """
    E_J = hbar * I_crit / (2 * e)
    return E_J / (kb * T) if T > 0 else np.inf

